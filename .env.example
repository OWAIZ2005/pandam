# =============================================================================
# PANDAM environment variables (EXAMPLE)
# Copy to .env / .env.local and fill in. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Expo app (apps/app)
# Public values only. Anything prefixed EXPO_PUBLIC_ is embedded in the client
# bundle and is NOT secret.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_WS_URL=ws://localhost:8787
EXPO_PUBLIC_ENV=development

# Sentry (client)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (client)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Cloudflare Worker (apps/worker)
# Server-side secrets are provided at runtime via `wrangler secret put` in
# deployed environments, and via apps/worker/.dev.vars locally (gitignored).
# The names below document what will eventually be required.
# -----------------------------------------------------------------------------
# Cloudflare account (used by wrangler / EAS / CI, not by the Worker runtime)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker runtime secrets (set locally in apps/worker/.dev.vars)
# JWT_SECRET=
# SENTRY_DSN=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# EAS Build (mobile)
# -----------------------------------------------------------------------------
EAS_PROJECT_ID=
