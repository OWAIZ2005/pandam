{
  "name": "@pandam/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "PANDAM universal app (iOS / Android / Web) — Expo + Expo Router",
  "scripts": {
    "dev": "expo start --port 3000",
    "dev:web": "expo start --web --port 3000",
    "dev:clear": "expo start --port 3000 --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform web --output-dir dist",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@pandam/app: no tests yet\"",
    "clean": "rm -rf dist .expo .turbo web-build *.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@pandam/types": "workspace:*",
    "@pandam/ui": "workspace:*",
    "@pandam/utils": "workspace:*",
    "@pandam/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@sentry/react-native": "~6.3.0",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~52.0.23",
    "expo-application": "~6.0.2",
    "expo-constants": "~17.0.4",
    "expo-device": "~7.0.2",
    "expo-image": "~2.0.4",
    "expo-linking": "~7.0.4",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "nativewind": "4.1.23",
    "posthog-react-native": "^3.3.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@pandam/config": "workspace:*",
    "@types/react": "~18.3.12",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~7.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
