{
  "name": "@pandam/worker",
  "version": "0.1.0",
  "private": true,
  "description": "PANDAM API — Cloudflare Worker (Hono)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist .turbo .wrangler coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@pandam/database": "workspace:*",
    "@pandam/types": "workspace:*",
    "@pandam/utils": "workspace:*",
    "@pandam/validation": "workspace:*",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@pandam/config": "workspace:*",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
