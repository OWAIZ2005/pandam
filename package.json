{
  "name": "pandam",
  "version": "0.1.0",
  "private": true,
  "description": "PANDAM - direct barter marketplace (technical foundation)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@pandam/app",
    "dev:worker": "turbo run dev --filter=@pandam/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@pandam/config": "workspace:*",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "react-native": "0.76.6",
      "nativewind": "4.1.23",
      "react-native-css-interop": "0.1.22"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18.3.1"
      }
    }
  }
}
