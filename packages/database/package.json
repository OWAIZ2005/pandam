{
  "name": "@pandam/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations and D1 client for PANDAM",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply pandam-db --local",
    "migrate:remote": "wrangler d1 migrations apply pandam-db --remote",
    "studio": "drizzle-kit studio",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@pandam/database: no tests yet\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@pandam/config": "workspace:*",
    "@types/node": "^20.17.12",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  }
}
